  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "precheck": "node scripts/precheck.js",
    "eas:build:preview": "pnpm run precheck && eas build --profile preview --platform android",
    "eas:build:production": "pnpm run precheck && eas build --profile production --platform android",
    "eas:build:all": "pnpm run precheck && eas build --profile production"
  },
